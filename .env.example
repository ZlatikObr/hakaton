OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k3.1-pro
# Alternatives: deepseek/deepseek-v4.1-flash-1017, deepseek/deepseek-v3.2
TZ_API_TOKEN=replace-with-a-long-random-local-token
TZ_DATA_DIR=./runs
TZ_MAX_STEPS=12
TZ_MAX_OUTPUT_TOKENS=12000
TZ_WEB_ENABLED=false
# Search uses the same OpenRouter key; only fixed public queries reach the isolated search worker.
TZ_SEARCH_BACKEND=openrouter
TZ_SEARCH_MODEL=deepseek/deepseek-v4.1-flash-1017
# Optional alternative: TZ_SEARCH_BACKEND=brave (requires the key below) or duckduckgo.
BRAVE_API_KEY=
# Личный кабинет: вход по коду из письма (необязательный для пользователя).
# Без SMTP вход отключен. TZ_AUTH_DEMO=true показывает код на экране вместо письма (только для демо).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TZ_AUTH_DEMO=false
# true, если сайт открыт по HTTPS
TZ_COOKIE_SECURE=false
