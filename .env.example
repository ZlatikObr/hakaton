# Скопируйте в .env и заполните нужное. Все переменные необязательны:
# без ключа сервис работает в локальном режиме (правила + справочник ОКПД 2, без модели).

# ── Модель (OpenRouter) ─────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k3.1-pro
# Другие варианты: deepseek/deepseek-v4.1-flash-1017, deepseek/deepseek-v3.2

# ── Модель через любой OpenAI-совместимый API (вместо OpenRouter) ──
# LLM_API_URL=https://api.aitunnel.ru/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL_NAME=kimi-k3.1-pro

# ── Поиск открытых нормативных источников ──────────────────────────
TZ_WEB_ENABLED=false
TZ_SEARCH_BACKEND=openrouter
TZ_SEARCH_MODEL=deepseek/deepseek-v4.1-flash-1017
# Альтернатива: TZ_SEARCH_BACKEND=brave (нужен ключ ниже) или duckduckgo
BRAVE_API_KEY=

# ── Лимиты агента ───────────────────────────────────────────────────
TZ_MAX_STEPS=12
TZ_MAX_OUTPUT_TOKENS=12000

# ── Сервис ──────────────────────────────────────────────────────────
# Токен для доступа к API из скриптов (Authorization: Bearer ...), не короче 24 символов.
# Если пусто — генерируется при старте, браузерный интерфейс работает без него.
TZ_API_TOKEN=
TZ_DATA_DIR=./runs
# Сколько часов хранить загруженные документы (0 — не удалять)
TZ_RETENTION_HOURS=24
# Порт на хосте для docker compose
TZ_PORT=8000
# Лимит процессоров контейнера (не больше, чем есть на машине)
TZ_CPUS=1

# ── Личный кабинет «Мои проверки» (необязательно) ──────────────────
# Без SMTP вход по коду отключён. TZ_AUTH_DEMO=true показывает код на экране (только для демо).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TZ_AUTH_DEMO=false
# true, если сайт открыт по HTTPS
TZ_COOKIE_SECURE=false
