# Скопируйте в .env и заполните нужное. Без ключа модели сервис работает в демо-режиме (локальные проверки).

# --- Модель (любой OpenAI-совместимый API) ---
# AITunnel:
LLM_API_KEY=
LLM_API_URL=https://api.aitunnel.ru/v1/chat/completions
LLM_MODEL_NAME=kimi-k3.1-pro
# Или OpenRouter (тогда LLM_API_URL и LLM_MODEL_NAME не задавать):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k3.1-pro

# --- Работа агента ---
# Пусто: случайный токен при каждом запуске (сайт работает, внешний API — нет).
TZ_API_TOKEN=
TZ_MAX_STEPS=12
TZ_MAX_OUTPUT_TOKENS=12000
# Поиск норм в интернете: openrouter (Exa через OpenRouter), duckduckgo или brave.
TZ_WEB_ENABLED=true
TZ_SEARCH_BACKEND=duckduckgo
TZ_SEARCH_MODEL=deepseek/deepseek-v4.1-flash-1017
BRAVE_API_KEY=

# --- Docker ---
TZ_PORT=8000
TZ_CPUS=1

# --- Хранение ---
TZ_DATA_DIR=./runs
# Файлы заданий удаляются через N часов после последнего изменения (0 — не удалять).
TZ_RETENTION_HOURS=24

# --- Личный кабинет ---
# true: код входа показывается на экране вместо письма (только для демонстрации).
TZ_AUTH_DEMO=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# В демо-режиме сохраненные проверки открываются по почте с любого устройства.
TZ_DEMO_SHARED_HISTORY=true

# --- Публикация на домене (за HTTPS-прокси) ---
TZ_COOKIE_SECURE=false
# TZ_PUBLIC_ORIGIN=https://example.ru
# TZ_PUBLIC_ACCESS=true
# TZ_PUBLIC_RUNS_PER_DAY=30
